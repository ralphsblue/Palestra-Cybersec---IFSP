# Copie este arquivo para .env e preencha os valores.

# Porta do servidor
PORT=3000

# URL publica do site (usada no callback do Google). Em producao use https://seu-dominio
BASE_URL=http://localhost:3000

# Segredo da sessao (qualquer string longa e aleatoria)
SESSION_SECRET=troque-isto-por-uma-string-aleatoria-longa

# Credenciais do painel /admin
ADMIN_USER=admin
ADMIN_PASS=troque-esta-senha
